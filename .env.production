# Committed: no secrets here. Secrets for this environment live in .env.production.local (ignored by
# git; made by likho-infra/scripts/make-env-secrets.py) or in Kubernetes Secrets (likho-deploy).
# Read order: .env, .env.local, .env.production, .env.production.local; a real environment variable wins.

LIKHO_ENV=production
LOG_LEVEL=INFO
HTTP_PORT=4010
GRPC_PORT=5010

# DATABASE_URL, S3_ACCESS_KEY, S3_SECRET_KEY, LINK_SECRET and PUBLIC_URL (the public domain):
# in .env.production.local
NATS_URL=nats://nats:4222
S3_ENDPOINT=http://objectstore:8333
S3_REGION=us-east-1
S3_BUCKET_ORIGINAL=likho-audio
S3_BUCKET_PLAYBACK=likho-normalized
S3_BUCKET_PEAKS=likho-peaks

DOWNLOAD_TTL_SECONDS=900
UPLOAD_TTL_SECONDS=3600
MAX_UPLOAD_MB=500

WORKERS=4
MAX_ATTEMPTS=5
WORK_DIR=/tmp
