# Committed: no secrets here. Secrets for this environment live in .env.development.local (ignored by
# git; made by likho-infra/scripts/make-env-secrets.py) or in Kubernetes Secrets (likho-deploy).
# Read order: .env, .env.local, .env.development, .env.development.local; a real environment variable wins.

LIKHO_ENV=development
LOG_LEVEL=INFO
HTTP_PORT=4010
GRPC_PORT=5010

# The likho-infra local stack
DATABASE_URL=postgres://likho_media:likho_media@localhost:5433/likho_media
NATS_URL=nats://localhost:4222
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=likho-dev
S3_SECRET_KEY=likho-dev-secret
S3_REGION=us-east-1
S3_BUCKET_ORIGINAL=likho-audio
S3_BUCKET_PLAYBACK=likho-normalized
S3_BUCKET_PEAKS=likho-peaks

# Links start with the gateway's address.
PUBLIC_URL=http://localhost:8080
LINK_SECRET=likho-dev-link-secret
DOWNLOAD_TTL_SECONDS=900
UPLOAD_TTL_SECONDS=3600
MAX_UPLOAD_MB=500

WORKERS=2
MAX_ATTEMPTS=5

# How long the start keeps trying to reach NATS before giving up.
NATS_CONNECT_TIMEOUT_SECONDS=120
# Metrics are always at GET /metrics. To also push them (OTLP/HTTP, e.g. the obs profile): http://localhost:4318
OTEL_EXPORTER_OTLP_ENDPOINT=
