# The service reads these from the environment. The defaults match the likho-infra local stack,
# so nothing has to be set on a developer's machine.

LIKHO_ENV=development
LOG_LEVEL=INFO

HTTP_PORT=4010
GRPC_PORT=5010

DATABASE_URL=postgres://likho_media:likho_media@localhost:5433/likho_media
NATS_URL=nats://localhost:4222

S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=likho-dev
S3_SECRET_KEY=likho-dev-secret
S3_REGION=us-east-1
S3_BUCKET_ORIGINAL=likho-audio
S3_BUCKET_PLAYBACK=likho-normalized
S3_BUCKET_PEAKS=likho-peaks

# The address browsers and workers reach this service at. Links start with it.
PUBLIC_URL=http://localhost:8080
# Signs upload and download links. Must be set to a long random value in production.
LINK_SECRET=likho-dev-link-secret
DOWNLOAD_TTL_SECONDS=900
UPLOAD_TTL_SECONDS=3600
MAX_UPLOAD_MB=500

# How many files are converted at the same time.
WORKERS=2
